diff --git a/core/src/avm2/optimizer/fuse.rs b/core/src/avm2/optimizer/fuse.rs
new file mode 100644
index 00000000..59cbccf1
--- /dev/null
+++ b/core/src/avm2/optimizer/fuse.rs
@@ -0,0 +1,102 @@
+use crate::avm2::op::{MEM_8, MEM_16, MEM_F32, MEM_F64, MEM_I32, Op};
+
+use std::cell::Cell;
+use std::collections::HashSet;
+
+/// Fuses sequences of ops that are very common in FlasCC (Alchemy) code into
+/// single ops, so that the interpreter dispatches fewer ops and moves fewer
+/// values through the operand stack. Only ops that are not jump targets are
+/// fused into the op before them. Run after DCE and before removing nops; the
+/// fused op takes the place of the first op of the sequence and the rest
+/// become nops.
+pub fn fuse_ops<'gc>(ops: &[Cell<Op<'gc>>], jump_targets: &HashSet<usize>) {
+    let idx: Vec<usize> = (0..ops.len())
+        .filter(|&i| !ops[i].get().is_nop())
+        .collect();
+
+    let mut k = 0;
+    while k < idx.len() {
+        let get = |j: usize| idx.get(k + j).map(|&i| ops[i].get());
+        // Nothing after the first op of a sequence may be a jump target, including
+        // nops in between
+        let free = |n: usize| {
+            idx.get(k + n - 1)
+                .is_some_and(|&last| (idx[k] + 1..=last).all(|i| !jump_targets.contains(&i)))
+        };
+        let replace = |n: usize, op: Op<'gc>| {
+            ops[idx[k]].set(op);
+            for j in 1..n {
+                ops[idx[k + j]].set(Op::Nop);
+            }
+        };
+
+        match (get(0), get(1), get(2)) {
+            (
+                Some(Op::GetLocal { index }),
+                Some(Op::PushInt { value }),
+                Some(add @ (Op::AddI | Op::SubtractI)),
+            ) if free(3) => {
+                let value = if matches!(add, Op::SubtractI) {
+                    value.wrapping_neg()
+                } else {
+                    value
+                };
+                let mem = |kind| (kind, false);
+                let fourth = if free(4) {
+                    match get(3) {
+                        Some(Op::SetLocal { index: dst }) => Some(Op::SetLocalAddI {
+                            src: index,
+                            dst,
+                            value,
+                        }),
+                        Some(op) => {
+                            let m = match op {
+                                Op::Li8 => Some(mem(MEM_8)),
+                                Op::Li16 => Some(mem(MEM_16)),
+                                Op::Li32 => Some(mem(MEM_I32)),
+                                Op::Lf32 => Some(mem(MEM_F32)),
+                                Op::Lf64 => Some(mem(MEM_F64)),
+                                Op::Si8 => Some((MEM_8, true)),
+                                Op::Si16 => Some((MEM_16, true)),
+                                Op::Si32 => Some((MEM_I32, true)),
+                                Op::Sf32 => Some((MEM_F32, true)),
+                                Op::Sf64 => Some((MEM_F64, true)),
+                                _ => None,
+                            };
+                            m.map(|(kind, store)| {
+                                if store {
+                                    Op::StoreLocalOffset { index, value, kind }
+                                } else {
+                                    Op::LoadLocalOffset { index, value, kind }
+                                }
+                            })
+                        }
+                        None => None,
+                    }
+                } else {
+                    None
+                };
+                if let Some(op) = fourth {
+                    replace(4, op);
+                    k += 4;
+                } else {
+                    replace(3, Op::GetLocalAddI { index, value });
+                    k += 3;
+                }
+                continue;
+            }
+            (Some(Op::PushInt { value }), Some(Op::SetLocal { index }), _) if free(2) => {
+                replace(2, Op::SetLocalInt { index, value });
+                k += 2;
+                continue;
+            }
+            (Some(Op::PushDouble { value }), Some(Op::SetLocal { index }), _) if free(2) => {
+                replace(2, Op::SetLocalDouble { index, value });
+                k += 2;
+                continue;
+            }
+            _ => {}
+        }
+        k += 1;
+    }
+}
